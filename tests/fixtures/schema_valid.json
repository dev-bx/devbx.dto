{
    "$schema": "devbx-dto/1.0",
    "package": {
        "name": "test-fixtures",
        "version": "1.0.0",
        "codeGen": {
            "php": {
                "namespace": "Tests\\DevBX\\DTO\\Generated"
            }
        }
    },
    "types": {
        "UserDTO": {
            "description": "Test user DTO",
            "properties": {
                "id": {
                    "type": "int"
                },
                "name": {
                    "type": "string",
                    "nullable": true,
                    "default": null
                },
                "isActive": {
                    "type": "bool",
                    "nullable": true,
                    "default": true
                },
                "tags": {
                    "type": "array",
                    "default": []
                },
                "email": {
                    "type": "string",
                    "nullable": true,
                    "default": null,
                    "mapFrom": "email_address"
                }
            }
        }
    }
}
